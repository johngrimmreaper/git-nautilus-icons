Package: git-nautilus-icons-common
Architecture: all
Multi-Arch: foreign
Depends:
 ${misc:Depends},
 hicolor-icon-theme
Breaks:
 nemo-git-nautilus-icons (<< ${binary:Version})
Replaces:
 nemo-git-nautilus-icons (<< ${binary:Version})
Description: Git status emblem icons for file manager extensions
 This package contains the shared Git status emblem icons used by the
 git-nautilus-icons file manager extensions.
 .
 These icons are used by the Nemo, Nautilus, and Caja extension packages.

Package: nemo-git-nautilus-icons
Architecture: all
Depends:
 ${misc:Depends},
 git,
 git-nautilus-icons-common (= ${binary:Version}),
 nemo,
 nemo-python,
 python3,
 python3-gi
Description: Git status emblems for Nemo
 This package installs a Nemo Python extension that overlays Git status
 emblems on files and directories inside Git repositories.
 .
 It can show modified, added, deleted, untracked, clean, repository,
 and ahead-of-remote states directly in the Nemo file manager.

Package: nautilus-git-nautilus-icons
Architecture: all
Depends:
